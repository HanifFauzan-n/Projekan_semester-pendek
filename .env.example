# Salin file ini menjadi .env di root proyek, lalu isi nilainya.
# JANGAN commit file .env. Kredensial asli tidak boleh masuk git.
#
# Format mengikuti aturan file .properties: KUNCI=nilai, tanpa tanda kutip,
# tanpa spasi di sekitar tanda sama dengan.

# ---------- Xendit (SKPL-F05) ----------
# Dashboard Xendit > Settings > Developers > API Keys.
# WAJIB memakai secret key mode TEST selama penelitian, bukan mode live.
# Key mode test diawali xnd_development_
XENDIT_API_KEY=

# Dashboard Xendit > Settings > Developers > Webhooks > Verification token.
# Token ini dikirim Xendit pada header X-CALLBACK-TOKEN setiap webhook.
# Kalau dikosongkan, semua webhook akan ditolak sistem.
XENDIT_CALLBACK_TOKEN=

# Alamat aplikasi. Untuk pengujian webhook dari Xendit, ganti dengan URL
# tunnel publik (misalnya hasil ngrok), karena Xendit tidak bisa
# menghubungi localhost.
APP_BASE_URL=http://localhost:8080
# Alamat frontend, tujuan pelanggan kembali setelah membayar di halaman Xendit
# (/topup/status/... dan /pesanan/...). Saat produksi satu origin: sama dengan APP_BASE_URL.
APP_URL=http://localhost:5173

# ---------- Google OAuth2 (SKPL-F03) ----------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# Tipe: Web application
# Authorized redirect URI: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Notifikasi email SMTP (SKPL-F18) ----------
# Gmail wajib memakai App Password, bukan password akun.
# Akun harus mengaktifkan verifikasi 2 langkah lebih dulu.
MAIL_USERNAME=
MAIL_APP_PASSWORD=
# Set false untuk mematikan pengiriman email saat menguji fitur lain
MAIL_ENABLED=true

# ---------- Supabase PostgreSQL (migrasi dari MySQL) ----------
# Supabase Dashboard > Connect > pilih tab "Session pooler".
# Contoh host: aws-0-ap-southeast-1.pooler.supabase.com
# Contoh user: postgres.abcdefghijklmnopqrst
# JANGAN pakai host db.[ref].supabase.co (IPv6 saja pada plan gratis)
# dan JANGAN pakai port 6543 (prepared statement tidak didukung).
# Projek-hanif: user aplikasi khusus zelatan_app (bukan postgres).
SUPABASE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_DB_USER=zelatan_app.mevzhxisbubhlnvwamje
SUPABASE_DB_PASSWORD=

# ---------- Admin awal (di-seed DataSeed saat tabel users belum berisi admin) ----------
ADMIN_USERNAME=Hanif18
ADMIN_PASSWORD=

# ---------- OpenRouter AI chat admin (SKPL-F20) ----------
# openrouter.ai > Keys. Model gratis berakhiran :free (openrouter.ai/models).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# model cadangan, dipisah koma, dipakai kalau model utama penuh/down
OPENROUTER_FALLBACK_MODELS=

# Dipakai frontend React untuk memanggil backend Spring Boot.
# Saat pengembangan cukup kosongkan: Vite proxy meneruskan /api ke localhost:8080
# sehingga frontend dan backend terhitung satu origin (tanpa CORS).
VITE_API_BASE_URL=
